{
  "name": "Automated Sales Reporting",
  "nodes": [
    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\n\nconst csv = input.data ?? input.body;\n\nif (typeof csv !== \"string\") {\n  throw new Error(\n    \"CSV text not found. Available fields: \" +\n    Object.keys(input).join(\", \")\n  );\n}\n\nconst lines = csv.trim().split(/\\r?\\n/);\nconst headers = lines[0].split(\",\");\n\nconst records = lines.slice(1).filter(line => line.trim() !== \"\").map(line => {\n  const values = line.split(\",\");\n  const record = {};\n\n  headers.forEach((header, index) => {\n    record[header.trim()] = values[index]?.trim();\n  });\n\n  record.units = Number(record.units);\n  record.revenue_usd = Number(record.revenue_usd);\n  record.expense_usd = Number(record.expense_usd);\n\n  return { json: record };\n});\n\nreturn records;\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        48
      ],
      "id": "032a61e6-abf9-497b-b316-a77167415bf5",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/sameagee/n8n-sales-reporting-workflow/main/sample-sales-data.csv",
        "options": {}
      },
