      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "\nconst records = $input.all().map(item => item.json);\n\nif (records.length === 0) {\n  throw new Error(\"No sales records received from the CSV Conversion node.\");\n}\n\nconst totalRecords = records.length;\n\nconst totalUnits = records.reduce(\n  (sum, r) => sum + Number(r.units || 0), 0\n);\n\nconst totalRevenue = records.reduce(\n  (sum, r) => sum + Number(r.revenue_usd || 0), 0\n);\n\nconst totalExpenses = records.reduce(\n  (sum, r) => sum + Number(r.expense_usd || 0), 0\n);\n\nreturn [{\n  json: {\n    report_name: \"Automated Sales Report\",\n    records_processed: totalRecords,\n    total_units_sold: totalUnits,\n    total_revenue_usd: Number(totalRevenue.toFixed(2)),\n    total_expenses_usd: Number(totalExpenses.toFixed(2)),\n    estimated_profit_usd: Number(\n      (totalRevenue - totalExpenses).toFixed(2)\n    )\n  }\n}];\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
